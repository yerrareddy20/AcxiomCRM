@model IEnumerable<AcxiomCRM.Models.AuditLog>

<h2>Audit Log Management</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Record ID</th>
            <th>Old Value</th>
            <th>New Value</th>
            <th>Date</th>
            <th>IP Address</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.UserId</td>
                <td>@log.Action</td>
                <td>@log.EntityName</td>
                <td>@log.RecordId</td>
                <td>@log.OldValue</td>
                <td>@log.NewValue</td>
                <td>@log.CreatedDate.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                <td>@log.IpAddress</td>
            </tr>
        }
    </tbody>
</table>